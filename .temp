parallel-jobs = 1                    # amount of cores to use for parallel patching, if not set $(nproc) is used
compression-level = 9                # module zip compression level
remove-rv-integrations-checks = true # remove checks from the extension

patches-source = "SysAdminDoc/HushTumblr" # where to fetch patches bundle from. default: "MorpheApp/morphe-patches"

[Tumblr]
app-name = "HushTumblr" # if set, release name becomes SomeApp instead of Some-App. default is same as table name, which is 'Some-App' here.

apkmirror-dlurl = "https://www.apkmirror.com/apk/tumblr-inc/tumblr"
# direct download url. the url must point to an apk file with name format shown in this example
direct-dlurl = "https://www.apkmirror.com/apk/tumblr-inc/tumblr/tumblr-social-media-art-47-0-0-108-release/tumblr-social-media-art-47-0-0-108-android-apk-download/download/?key=9af484c77d9f370c41215cdc33fded150e97cca4"

arch = "arm64-v8a" 
